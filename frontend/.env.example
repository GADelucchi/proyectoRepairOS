# ============================================================
# RepairOS - Frontend
# Copiá este archivo a .env y completá los valores.
# ============================================================

# URL de la API (incluye /api).
VITE_API_BASE_URL=http://localhost:4000/api

# Taller de demostración pública. Si se dejan vacías, el login no muestra el bloque de demo.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Dominio del landing, donde viven las páginas legales.
VITE_LEGAL_BASE_URL=https://repairos.app
