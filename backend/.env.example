# ============================================================
# RepairOS - Backend
# Copiá este archivo a .env y completá los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# ---- Entorno ----
NODE_ENV=development
PORT=4000

# Zona horaria del negocio: define qué es "hoy" en la caja y la hora del remito.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# ---- Base de datos MySQL ----
# La base se crea sola con `npm run db:init` si no existe.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=repairos
DB_USER=root
DB_PASSWORD=

# ---- JWT ----
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# ---- Cifrado de datos sensibles ----
# Clave de desbloqueo de equipos y credenciales de cuentas vinculadas.
# DEBE ser hexadecimal de 64 caracteres (32 bytes) y ser única por entorno.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si la cambiás con datos ya cargados, correr antes: npm run keys:rotate
ENCRYPTION_KEY=

# ---- CORS ----
# Orígenes del frontend permitidos, separados por coma.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Almacenamiento de imágenes: "local" o "s3" ----
STORAGE_DRIVER=local

# Solo si STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=uploads
LOCAL_PUBLIC_URL=http://localhost:4000/uploads

# Solo si STORAGE_DRIVER=s3 (AWS S3, DigitalOcean Spaces, MinIO, etc.)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false

# ---- Email transaccional (Resend) ----
# Sin RESEND_API_KEY los emails se omiten y solo se registran en consola.
RESEND_API_KEY=
EMAIL_FROM=RepairOS <no-reply@example.com>

# ---- WhatsApp (reservado para integración futura) ----
WHATSAPP_PROVIDER=none
WHATSAPP_API_KEY=

# Administración de la plataforma: emails separados por coma. Ven la sección
# Plataforma (todos los talleres) y reciben el aviso de cada taller o usuario nuevo.
PLATFORM_ADMIN_EMAILS=
# Contacto que ve un taller con la suscripción vencida (por defecto, el primer admin de plataforma).
SOPORTE_EMAIL=
# WhatsApp de soporte con código de país, sin + (lo ve un taller con la suscripción vencida).
SOPORTE_WHATSAPP=
# Usuario del taller de demo pública: su sesión muestra el botón "Crear mi taller".
DEMO_EMAIL=demo@repairos.ar

# Dirección pública del frontend: links de los emails y del seguimiento de órdenes.
APP_PUBLIC_URL=http://localhost:5173
# Exigir la verificación del email al registrarse. Activar SOLO con RESEND_API_KEY configurada.
EXIGIR_EMAIL_VERIFICADO=false
